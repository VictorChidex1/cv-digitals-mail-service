# API runtime configuration.
# Copy to apps/api/.env (gitignored). Never commit a real .env file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4100
WEB_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=cv-digitals-mail-dev

# Local/test only. The Admin SDK reads this automatically.
# Never set this in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional. Defaults to <repo root>/data/cv-digitals-mail.db
# DATABASE_PATH=
