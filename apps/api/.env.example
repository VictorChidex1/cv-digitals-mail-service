# API runtime configuration.
# Copy to apps/api/.env (gitignored). Never commit a real .env file.

NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=cv-digitals-mail-dev

# Local/test only. The Admin SDK reads this automatically.
# Never set this in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-side allowlist. A valid Firebase token is NOT enough on its own;
# the identity must appear here. Empty means every request is rejected (403).
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_UIDS=

# Operational settings
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=30

# Only set true to expose the API beyond loopback, which requires approval.
ALLOW_NON_LOOPBACK=false

# Optional. Defaults to <repo root>/data/cv-digitals-mail.db
# DATABASE_PATH=
