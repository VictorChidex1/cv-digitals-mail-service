# Client-safe Firebase configuration for the Next.js app.
# Copy to apps/web/.env.local (gitignored). These values are public by design;
# never put secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cv-digitals-mail-dev
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development: connect the client SDK to the Auth emulator.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Local Express API
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
