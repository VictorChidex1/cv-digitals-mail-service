{
  "name": "cv-digitals-mail",
  "version": "0.1.0",
  "private": true,
  "description": "CV Digitals Mail — local-first outreach CRM and sending operations platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api,auth -c blue,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:auth\"",
    "dev:web": "npm run dev -w @cv-digitals/web",
    "dev:api": "npm run dev -w @cv-digitals/api",
    "dev:auth": "firebase emulators:start --only auth --project cv-digitals-mail-dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "~5.9.3"
  }
}
